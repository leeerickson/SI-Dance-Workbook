{
  "name": "workbook-player",
  "version": "0.4.0",
  "private": true,
  "description": "Choreography Workbook Player for Android: opens .dance files and plays them.",
  "scripts": {
    "vendor": "node -e \"require('fs').copyFileSync(require.resolve('jszip/dist/jszip.min.js'),'www/vendor/jszip.min.js')\"",
    "sync": "npm run vendor && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0",
    "@capacitor/filesystem": "6.0.3",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/share": "6.0.3",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0"
  }
}
